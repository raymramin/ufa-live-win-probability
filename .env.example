# Copy this file to `.env` and fill in values locally.
# NEVER commit a real `.env` — it is gitignored.

# Preferred: full SQLAlchemy URL
DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@HOST:5432/DATABASE

# Or discrete pieces (used only if DATABASE_URL is empty):
# DB_HOST=db.example.com
# DB_PORT=5432
# DB_USER=readonly_user
# DB_PASSWORD=replace_me
# DB_NAME=postgres

# Optional: path to ShownSpace production joblibs (cp/fv/win)
# Defaults to ../shownspace_backend/models if that folder exists.
# SHOWNSPACE_MODELS_DIR=C:/Users/you/Desktop/shownspace_backend/models
