# Never commit secrets or local credentials
.env
.env.*
!.env.example
*.pem
*.key
credentials*.json
**/secrets/**

# Python / tooling
.venv/
venv/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
*.egg-info/
dist/
build/

# Local data & trained weights (regenerate locally)
data/**
!data/.gitkeep
models/**
!models/.gitkeep
*.joblib
*.pkl
*.parquet
*.csv
!docs/**/*.csv

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Keep published site assets
!figures/.gitkeep
!figures/*.html
!figures/*.svg
!site/data/*.json
!site/**/*.html
